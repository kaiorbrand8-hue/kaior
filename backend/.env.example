PORT=5000
# Local dev DB started by `npm run devmongo` (persists to backend/data/mongo).
# For production, point this at MongoDB Atlas (or a real mongod) instead.
MONGO_URI=mongodb://127.0.0.1:27117/kaior
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:3000
ADMIN_EMAIL=admin@kaior.com
ADMIN_PASSWORD=Admin@12345

# Cloudinary — used for all admin image uploads (products, categories,
# homepage images). Get these from https://cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sign-In — get from https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Same value is used by the
# frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Resend — used to send "forgot password" reset emails. Get an API key from
# https://resend.com/api-keys. EMAIL_FROM can stay as the default sandbox
# sender until a domain is verified in Resend for a branded @kaiorshope.com
# address.
RESEND_API_KEY=
EMAIL_FROM=KAIOR <onboarding@resend.dev>
